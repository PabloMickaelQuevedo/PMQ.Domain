<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Os pacotes PMQ são liberados juntos e testados como um conjunto, então a política é
    declarar a versão corrente de cada um em vez do mínimo teórico. Um consumidor que
    instale só este pacote recebe uma combinação coerente, e não a mais antiga que
    ainda compila.
  -->
  <ItemGroup>
    <!-- IDomainEvent herda de INotification para ser despachável pelo mediator. -->
    <PackageVersion Include="PMQ.Mediator" Version="1.1.1" />
    <!-- Entity e ValueObject herdam de Validatable. -->
    <PackageVersion Include="PMQ.Notifications" Version="1.1.1" />
  </ItemGroup>

  <ItemGroup Label="Testes">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>

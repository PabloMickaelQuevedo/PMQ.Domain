<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Os pacotes PMQ são liberados juntos e testados como um conjunto, então a política é
    declarar a versão corrente de cada um em vez do mínimo teórico. Um consumidor que
    instale só este pacote recebe uma combinação coerente, e não a mais antiga que
    ainda compila.
  -->
  <ItemGroup>
    <!-- IDomainEvent herda de INotification para ser despachável pelo mediator. -->
    <PackageVersion Include="PMQ.Mediator" Version="1.1.2" />
    <!-- Entity e ValueObject herdam de Validatable. -->
    <PackageVersion Include="PMQ.Notifications" Version="1.1.2" />
  </ItemGroup>

  <ItemGroup Label="Testes">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <!--
      Cobertura pelo Microsoft.Testing.Platform. O coverlet.collector é data collector
      do VSTest e não roda neste caminho: no xunit.v3 o MTP não suporta mais a ponte
      VSTest no SDK 10.
    -->
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
  </ItemGroup>

</Project>

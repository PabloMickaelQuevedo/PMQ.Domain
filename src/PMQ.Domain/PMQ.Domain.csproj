<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>PMQ.Domain</PackageId>
    <Version>1.0.4</Version>
    <Product>PMQ.Domain</Product>
    <Description>
      Domain-Driven Design building blocks for .NET: entities with identity-based equality, aggregate roots, value objects and domain events. Validation is accumulated as notifications instead of thrown as exceptions.
    </Description>
    <PackageProjectUrl>https://github.com/PabloMickaelQuevedo/PMQ.Domain</PackageProjectUrl>
    <RepositoryUrl>https://github.com/PabloMickaelQuevedo/PMQ.Domain.git</RepositoryUrl>
    <PackageTags>ddd;domain-driven-design;entity;aggregate;value-object;domain-events;notifications</PackageTags>
    <IncludeLicenseFile>true</IncludeLicenseFile>
  </PropertyGroup>
  <!--
    Compara a API deste build com a do pacote já publicado, baixado do NuGet, e por
    target framework. Remover membro público reprova o pack com CP0002.

    O baseline é a última versão publicada e sobe junto com o release. Quebra
    intencional se registra com -p:ApiCompatGenerateSuppressionFile=true, commitando
    o arquivo gerado — a decisão fica explícita e revisável em vez de silenciosa.

    Compara assinatura, não piso de dependência: subir o grupo net8.0 para um pacote
    10.x continua sendo trabalho do guard em Directory.Build.targets.
  -->
  <PropertyGroup Label="Compatibilidade">
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.0.4</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PMQ.Mediator" />
    <PackageReference Include="PMQ.Notifications" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PMQ.Domain.Tests" />
  </ItemGroup>

</Project>
